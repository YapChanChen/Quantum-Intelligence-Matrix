import math

# 量子智力评估矩阵
def quantum_iq(dimensions, weights, social_compatibility):
    """
    根据给定的维度、权重和社会兼容性因子计算量子IQ。

    参数:
        dimensions (list): 每个维度的得分列表。
        weights (list): 每个维度的权重列表。
        social_compatibility (list): 每个维度的社会兼容性因子列表。

    返回值:
        float: 计算出的量子IQ。
    """
    iq_quantum = 0
    for i in range(9):
        iq_quantum += weights[i] * dimensions[i] * math.exp(-social_compatibility[i])
    return iq_quantum / 9

if __name__ == "__main__":
    # 示例数据
    dimensions = [147, 89, 120, 110, 135, 140, 130, 125, 150]  # 每个维度的得分
    weights = [1, 1, 1, 1, 1, 1, 1, 1, 1]  # 默认权重为1
    social_compatibility = [0.5, 0.3, 0.2, 0.4, 0.1, 0.3, 0.2, 0.4, 0.3]  # 示例社会兼容性因子

    iq = quantum_iq(dimensions, weights, social_compatibility)
    print(f"您的量子IQ为: {iq:.2f}")
